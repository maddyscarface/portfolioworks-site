# ─────────────────────────────────────────────────────────────
# PortfolioWorks — environment variables (full list; see docs/16-technical-deployment.md)
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# Every integration is OFF until its variables are set.
# ─────────────────────────────────────────────────────────────

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_PHONE=                 # tracking number shown in header/contact; blank hides phone CTAs

# --- Google Tag Manager (optional) ---
NEXT_PUBLIC_GTM_ID=
# "true" = GA4 / Google Ads / Meta browser tags are managed inside GTM, so the direct tags below are skipped.
# Never run both, or conversions double-count.
NEXT_PUBLIC_TAGS_VIA_GTM=

# --- Direct browser tags (Phase 2). Each loads ONLY after the visitor accepts ad cookies; GPC always blocks. ---
NEXT_PUBLIC_GA4_ID=                # G-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=         # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL= # conversion label for the "Lead" action (transaction_id = lead event_id; enhanced conversions on)
NEXT_PUBLIC_META_PIXEL_ID=         # same pixel as META_PIXEL_ID below (browser eventID = CAPI event_id → deduplicated)

# --- Staging / feature flags ---
SITE_NOINDEX=                      # "1" forces noindex (Vercel preview deployments are noindexed automatically via VERCEL_ENV=preview)
NEXT_PUBLIC_PORTAL_PREVIEW=        # "true" shows the /portal demo-data prototype. Leave blank on production.

# --- Admin ---
ADMIN_PASSWORD=                    # basic auth for /admin (prod /admin returns 404 until set)
ALLOW_DEMO_ADMIN=                  # "true" opens /admin in prod without a password — demo only, never real prod

# --- Storage, idempotency, rate limit (Upstash Redis REST) — REQUIRED in production ---
# Without these, /api/leads returns 503 in production instead of keeping leads in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# LOCAL / PREVIEW TESTING ONLY: accept leads into process memory without Upstash. Ignored when VERCEL_ENV=production
# (specs/03 §6), so the production 503 guard always holds until Upstash is configured. Scope it to Preview only in Vercel.
LEAD_ALLOW_MEMORY_STORE=

# --- Cloudflare Turnstile (Phase 2: widget now renders in LeadForm) ---
# Set BOTH together. A secret without the site key = every lead fails verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- GoHighLevel (LeadConnector API v2, Private Integration token) ---
# PortfolioWorks' OWN sub-account. Without token + location the site runs in log mode (plan logged, PII masked, nothing sent).
GHL_MODE=                          # live | log | off (default: live when token+location are set, else log)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Project pipelines (specs/03 §3), identical stages: New inquiry → Qualified → Walkthrough requested → Walkthrough completed →
# Scope developing → Proposal sent → Awarded → In progress → Closeout → Repeat opportunity. Lost = opportunity status, not a stage.
# Only NEW_INQUIRY is required for intake (GHL_STAGE_MAIN_NEW_LEAD is still accepted as a fallback); the rest let the webhook move stages.
# MAIN = landlords, PMs, investors, HOAs.  RESIDENTIAL = homeowners renovating their own residence (never mixed with MAIN).
GHL_PIPELINE_MAIN=
GHL_STAGE_MAIN_NEW_INQUIRY=
GHL_STAGE_MAIN_QUALIFIED=
GHL_STAGE_MAIN_WALKTHROUGH_REQUESTED=
GHL_STAGE_MAIN_WALKTHROUGH_COMPLETED=
GHL_STAGE_MAIN_SCOPE_DEVELOPING=
GHL_STAGE_MAIN_PROPOSAL_SENT=
GHL_STAGE_MAIN_AWARDED=
GHL_STAGE_MAIN_IN_PROGRESS=
GHL_STAGE_MAIN_CLOSEOUT=
GHL_STAGE_MAIN_REPEAT_OPPORTUNITY=
GHL_PIPELINE_RESIDENTIAL=
GHL_STAGE_RESIDENTIAL_NEW_INQUIRY=
GHL_STAGE_RESIDENTIAL_QUALIFIED=
GHL_STAGE_RESIDENTIAL_WALKTHROUGH_REQUESTED=
GHL_STAGE_RESIDENTIAL_WALKTHROUGH_COMPLETED=
GHL_STAGE_RESIDENTIAL_SCOPE_DEVELOPING=
GHL_STAGE_RESIDENTIAL_PROPOSAL_SENT=
GHL_STAGE_RESIDENTIAL_AWARDED=
GHL_STAGE_RESIDENTIAL_IN_PROGRESS=
GHL_STAGE_RESIDENTIAL_CLOSEOUT=
GHL_STAGE_RESIDENTIAL_REPEAT_OPPORTUNITY=

# Portfolio / recurring-contract pipeline: Prospect → Contact verified → Consultation → Vendor prequalification →
# Pilot property → Approved vendor → Recurring work → Expansion (not-a-fit = status lost). Consultation precedes any proposal.
GHL_PIPELINE_PARTNERSHIP=
GHL_STAGE_PARTNERSHIP_PROSPECT=
GHL_STAGE_PARTNERSHIP_CONTACT_VERIFIED=
GHL_STAGE_PARTNERSHIP_CONSULTATION=
GHL_STAGE_PARTNERSHIP_VENDOR_PREQUAL=
GHL_STAGE_PARTNERSHIP_PILOT_PROPERTY=
GHL_STAGE_PARTNERSHIP_APPROVED_VENDOR=
GHL_STAGE_PARTNERSHIP_RECURRING_WORK=
GHL_STAGE_PARTNERSHIP_EXPANSION=

GHL_PIPELINE_MA=
GHL_STAGE_MA_NEW_INQUIRY=
GHL_PIPELINE_FL=
GHL_STAGE_FL_NEW_INQUIRY=
GHL_PIPELINE_ME=
GHL_STAGE_ME_NEW_INQUIRY=
# Follow-up workflows. Tag triggers (pw-fu:*) work with no IDs; IDs here also enroll directly via API.
GHL_WORKFLOW_INSTANT_RESPONSE=
GHL_WORKFLOW_SPEED_TO_LEAD=
GHL_WORKFLOW_PHOTO_REQUEST=
GHL_WORKFLOW_WARM_NURTURE=
GHL_WORKFLOW_LONG_NURTURE=
GHL_WORKFLOW_PARTNERSHIP=
GHL_WORKFLOW_URGENT=
GHL_WORKFLOW_WAITLIST=
GHL_WORKFLOW_OUT_OF_AREA=

CRM_WEBHOOK_SECRET=

# --- Meta Conversions API (server) ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=              # set only while testing in Events Manager

# --- GA4 Measurement Protocol (server events) ---
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- OpenAI Ads (ChatGPT ads) — Ads Manager → Conversions tab ---
# Browser pixel (public). Loads only after advertising consent; GPC always blocks it.
NEXT_PUBLIC_OPENAI_PIXEL_ID=
# Set "true" while testing to log pixel activity in the browser console.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
# Conversions API (server only, never expose). Must use the SAME pixel id as above for dedup.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_API_KEY=
# "true" = OpenAI validates events but does not record them. Turn off at launch.
OPENAI_ADS_VALIDATE_ONLY=true
OPENAI_ADS_INTEGRATION_SOURCE=

# --- Revenue attribution reports (Phase 2) ---
ATTRIBUTION_EXPORT_SECRET=         # enables /api/attribution/summary and /api/attribution/google-ads-offline (?key=...)
# Per-event Google Ads offline conversion action names (specs/03 §4). Defaults: "PortfolioWorks - Qualified Lead" /
# "- Walkthrough Scheduled" / "- Estimate Sent" / "- Proposal Won" / "- Realized Revenue"
GOOGLE_ADS_CONV_QUALIFIED_LEAD=
GOOGLE_ADS_CONV_SITE_WALK_BOOKED=
GOOGLE_ADS_CONV_PROPOSAL_SENT=
GOOGLE_ADS_CONV_CONTRACT_SIGNED=
GOOGLE_ADS_CONV_PURCHASE=
GOOGLE_ADS_OFFLINE_CONVERSION_NAME= # must match the Google Ads offline conversion action (legacy override for proposal won / contract_signed)

# --- Intent data: DataMoon or AudienceLab (Phase 2 adapter, OFF by default) ---
INTENT_PROVIDER=                   # datamoon | audiencelab
INTENT_ENABLED=                    # "true" = on (kill switch). Requires privacy review first.
INTENT_API_KEY=
INTENT_API_URL=
INTENT_WEBHOOK_SECRET=
NEXT_PUBLIC_INTENT_ENABLED=        # "true" + pixel src below = load the provider pixel after ad consent
NEXT_PUBLIC_INTENT_PIXEL_SRC=

# --- Team lead brief email (Resend) ---
RESEND_API_KEY=
LEAD_BRIEF_FROM=
LEAD_BRIEF_TO=

# --- Content-Security-Policy ---
# CSP ships as Report-Only (allows OpenAI pixel bzrcdn/bzr.openai.com, GTM/GA4, Meta, Turnstile, GHL, Supabase).
# Check the browser console for violations after GTM is live, then set "true" to enforce.
CSP_ENFORCE=
